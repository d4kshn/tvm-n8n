      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.graphBase }}/sites/{{ $json.srcSiteId }}/drive/root:/{{ encodeURIComponent($json.srcFolderPath) }}:/children?$select=name,id&$top=999",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {}
      },
      "id": "ec5c6a1b-d528-4a59-a4b2-d63ed276ba42",
      "name": "List folder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Reads the folder listing (Graph /children) and returns the single newest file.\n// If we've already processed that file, returns nothing so the run stops here.\nconst resp = $input.first().json;\nconst files = Array.isArray(resp.value) ? resp.value : [];\n\nconst re = /SLA_Flow_Stock_(\\d{4}-\\d{2}-\\d{2})\\.html$/i;\n\nconst dated = files\n  .map((f) => {\n    const m = String(f.name ?? '').match(re);\n    return m ? { file: f, date: m[1] } : null;\n  })\n  .filter(Boolean)\n  .sort((a, b) => (a.date < b.date ? 1 : -1)); // newest first\n\nif (dated.length === 0) return [];\n\nconst newest = dated[0];\nconst store = $getWorkflowStaticData('global');\nif (store.lastProcessedFile === newest.file.name) return []; // nothing new -> stop\nstore.lastProcessedFile = newest.file.name;\nreturn [{ json: { id: newest.file.id, name: newest.file.name } }];"
      },
      "id": "9bf9d81d-a690-475d-8fe1-4c26751f19b4",
      "name": "Pick newest file",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        870,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.graphBase }}/sites/{{ $('Config').first().json.dstSiteId }}/drive/items/{{ $('Config').first().json.dstItemId }}/workbook/tables('{{ $('Config').first().json.dstTable }}')/dataBodyRange?$select=address,rowCount",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {}
      },
      "id": "9378f345-5d27-4a77-933d-26f84b151f90",
      "name": "Get table range",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1080,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.graphBase }}/sites/{{ $('Config').first().json.dstSiteId }}/drive/items/{{ $('Config').first().json.dstItemId }}/workbook/worksheets('{{ $('Config').first().json.dstSheet }}')/range(address='{{ ($json.address || '').split('!').pop() }}')/delete",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"shift\":\"Up\"}",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {}
      },
      "id": "4f1a2495-1e19-46b4-97ce-35ca7a684126",
      "name": "Clear table rows",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1290,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.graphBase }}/sites/{{ $('Config').first().json.srcSiteId }}/drive/items/{{ $('Pick newest file').first().json.id }}/content",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "178afbb2-acb7-40fc-8e14-0d20e3bfb146",
      "name": "Download file",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1500,
        300
      ]
    },
    {
      "parameters": {
        "operation": "extractHtmlContent",
        "sourceData": "json",
        "dataPropertyName": "data",
        "extractionValues": {
          "values": [
            {
              "key": "rowHtml",
              "cssSelector": "table tr",
              "returnValue": "html",
              "returnArray": true
            }
          ]
        },
        "options": {}
      },
      "id": "abd7832e-5a35-461d-8b37-ace7cdf6a141",
      "name": "Extract rows",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        1710,
        300
      ]
    },
    {
