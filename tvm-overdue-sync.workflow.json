              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "4adbf845-3ee2-4402-a005-5207a8ae1b05",
      "name": "Every 15 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
