    {
      "parameters": {
        "jsCode": "// Local test build: plain-text columns (Ticket + URL).\n// A clickable =HYPERLINK needs the online/Graph version (or a SheetJS code node).\nreturn $input.all().map((item) => {\n  const j = item.json;\n  return {\n    json: {\n      'Overdue Tickets': String(j.ticket ?? '').trim(),\n      'Ticket URL': String(j.url ?? '').trim(),\n      'Severity': String(j.severity ?? '').trim(),\n      'Assignment': String(j.owner ?? '').trim(),\n      'State': String(j.state ?? '').trim(),\n      'Summary': '',\n    },\n  };\n});"
      },
      "id": "e8184a46-ce1a-434a-83c6-d74524ff107a",
