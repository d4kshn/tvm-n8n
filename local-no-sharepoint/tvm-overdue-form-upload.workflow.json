      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        1710,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Plain-text columns (Ticket + URL). A clickable =HYPERLINK needs the online/Graph version.\nreturn $input.all().map((item) => {\n  const j = item.json;\n  return {\n    json: {\n      'Overdue Tickets': String(j.ticket ?? '').trim(),\n      'Ticket URL': String(j.url ?? '').trim(),\n      'Severity': String(j.severity ?? '').trim(),\n      'Assignment': String(j.owner ?? '').trim(),\n      'State': String(j.state ?? '').trim(),\n      'Summary': '',\n    },\n  };\n});"
      },
      "id": "194bc8f2-f752-4bc9-939a-5749d0601c04",
      "name": "Build rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
