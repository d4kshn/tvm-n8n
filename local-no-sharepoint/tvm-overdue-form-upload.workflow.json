    {
      "parameters": {
        "jsCode": "// Expose whichever binary property the form produced as `data`,\n// so the HTML parser has a predictable field to read.\nconst item = $('On form submission').first();\nconst bin = item.binary || {};\nconst key = Object.keys(bin)[0];\nif (!key) {\n  throw new Error('No uploaded file found on the form submission.');\n}\nreturn [{ json: {}, binary: { data: bin[key] } }];"
      },
      "id": "2f99dd0b-363c-430c-8ce6-06f182596478",
      "name": "Normalize upload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
