      "id": "de9d8347-9ee7-4b21-a4e5-d369a219b7a5",
      "name": "Keep overdue for owners",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        1710,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build the output columns, de-duplicated by ticket number.\n// The dashboard can list the same ticket in more than one table/section,\n// so keep only the first occurrence of each ticket.\nconst num = (v) => {\n  const n = Number(String(v ?? '').trim());\n  return Number.isFinite(n) ? n : String(v ?? '').trim();\n};\nconst seen = new Set();\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const ticket = String(j.ticket ?? '').trim();\n  if (!ticket || seen.has(ticket)) continue;\n  seen.add(ticket);\n  out.push({\n    json: {\n      'Overdue Tickets': ticket,\n      'Ticket URL': String(j.url ?? '').trim(),\n      'Severity': String(j.severity ?? '').trim(),\n      'State': String(j.state ?? '').trim(),\n      'Status': String(j.sla ?? '').trim(),\n      'Assignment Group': String(j.group ?? '').trim(),\n      'Assignment': String(j.owner ?? '').trim(),\n      'Created': String(j.created ?? '').trim(),\n      'Days Actual': num(j.daysActual),\n      'SLA Days': num(j.slaDays),\n      'Days Over': num(j.daysOver),\n      'Summary': '',\n    },\n  });\n}\nreturn out;"
      },
